---
const { t } = Astro.props;
const links = [
  { id: "ai", label: t.nav.ai },
  { id: "cases", label: t.nav.cases },
  { id: "skills", label: t.nav.skills },
  { id: "experience", label: t.nav.experience },
  { id: "projects", label: t.nav.projects },
  { id: "contact", label: t.nav.contact },
];
---

<nav
  id="site-nav"
  class="hidden md:flex fixed top-4 left-4 z-50 items-center gap-1 p-1.5 rounded-full bg-white/75 dark:bg-gray-900/75 backdrop-blur-md border border-gray-200 dark:border-gray-700 shadow-lg transition-transform duration-300"
  aria-label="Secciones"
>
  <a href="#hero" class="px-3 py-1.5 rounded-full font-extrabold text-sm bg-gradient-to-r from-blue-600 to-violet-600 text-white">EM</a>
  {
    links.map((l) => (
      <a
        href={`#${l.id}`}
        data-nav={l.id}
        class="nav-link px-3 py-1.5 rounded-full text-sm font-medium text-gray-600 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
      >
        {l.label}
      </a>
    ))
  }
</nav>

<style>
  .nav-link.active {
    background: rgb(37 99 235 / 0.1);
    color: rgb(37 99 235);
  }
  :global(.dark) .nav-link.active {
    background: rgb(96 165 250 / 0.15);
    color: rgb(147 197 253);
  }
</style>

<script>
  // Resalta la sección visible
  const links = document.querySelectorAll<HTMLAnchorElement>("[data-nav]");
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        links.forEach((l) => l.classList.toggle("active", l.dataset.nav === entry.target.id));
      });
    },
    { rootMargin: "-45% 0px -50% 0px" },
  );
  links.forEach((l) => {
    const section = document.getElementById(l.dataset.nav!);
    if (section) observer.observe(section);
  });
</script>
