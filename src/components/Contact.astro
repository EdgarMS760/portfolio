---
import GitHub from "../assets/iconos/GitHub.svg";
import Linkedin from "../assets/iconos/LinkedIn.svg";
import cv from "../assets/iconos/cv.svg";
const { t } = Astro.props;
const c = t.contact;
---

<section id="contact" class="scroll-mt-24 py-24 px-6 lg:px-20 max-w-screen-xl mx-auto">
  <div
    class="relative overflow-hidden rounded-3xl p-10 lg:p-16 text-center text-white bg-gradient-to-br from-blue-600 via-indigo-600 to-violet-700 shadow-2xl"
    data-reveal
  >
    <div class="absolute -top-20 -right-20 w-72 h-72 rounded-full bg-white/10 blur-2xl"></div>
    <div class="absolute -bottom-24 -left-16 w-72 h-72 rounded-full bg-black/10 blur-2xl"></div>
    <h2 class="relative text-4xl lg:text-6xl font-extrabold mb-5">{c.title}</h2>
    <p class="relative text-lg lg:text-xl text-white/85 max-w-2xl mx-auto mb-9">{c.text}</p>
    <div class="relative flex flex-wrap justify-center items-center gap-4">
      <a
        href={`mailto:${c.email}`}
        class="px-7 py-3.5 rounded-xl bg-white text-indigo-700 font-bold shadow-lg hover:-translate-y-0.5 hover:shadow-xl transition"
      >
        {c.emailCta} ✉️
      </a>
      <a href="https://www.linkedin.com/in/edgarms01" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="p-3 rounded-xl bg-white/15 hover:bg-white/25 transition">
        <img src={Linkedin.src} alt="LinkedIn" class="w-7 h-7 invert" />
      </a>
      <a href="https://github.com/EdgarMS760" target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="p-3 rounded-xl bg-white/15 hover:bg-white/25 transition">
        <img src={GitHub.src} alt="GitHub" class="w-7 h-7 invert" />
      </a>
      <a href={t.cv} target="_blank" rel="noopener noreferrer" aria-label="CV" class="p-3 rounded-xl bg-white/15 hover:bg-white/25 transition">
        <img src={cv.src} alt="CV" class="w-7 h-7 invert" />
      </a>
    </div>
    <p class="relative mt-6 text-sm text-white/70">{c.email}</p>
  </div>
  <p class="text-center text-sm text-gray-500 dark:text-gray-400 mt-10">
    © {new Date().getFullYear()} Edgar Martínez · {c.footer}
  </p>
</section>

<script>
  import { initReveal } from "../scripts/reveal";
  initReveal();
</script>
