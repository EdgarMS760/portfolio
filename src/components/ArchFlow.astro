---
/**
 * Diagrama de arquitectura animado.
 * `layers` es una lista de capas; cada capa es una lista de nodos.
 * Entre capas se dibuja un conector con un pulso que viaja hacia abajo.
 */
interface Props {
  layers: string[][];
  color: string;
  hint?: string;
  size?: "sm" | "lg";
}
const { layers, color, hint, size = "sm" } = Astro.props;
const big = size === "lg";
---

<div
  class={`arch-flow relative rounded-2xl bg-gray-950 text-white border border-white/10 shadow-2xl overflow-hidden ${big ? "p-6 sm:p-10" : "p-5 sm:p-6"}`}
  style={`--accent: ${color};`}
  data-arch-flow
>
  <div class="arch-glow absolute inset-0 pointer-events-none"></div>
  <div class="relative flex items-center justify-between mb-5">
    <div class="flex gap-1.5">
      <span class="w-2.5 h-2.5 rounded-full bg-red-400/80"></span>
      <span class="w-2.5 h-2.5 rounded-full bg-yellow-400/80"></span>
      <span class="w-2.5 h-2.5 rounded-full bg-green-400/80"></span>
    </div>
    {hint && <span class="text-[11px] uppercase tracking-widest text-white/50 font-semibold">{hint}</span>}
  </div>

  <div class="relative flex flex-col items-center">
    {
      layers.map((layer, li) => (
        <>
          {li > 0 && (
            <div class={`arch-link relative w-px ${big ? "h-10" : "h-7"} bg-white/15`}>
              <span class="arch-pulse" style={`animation-delay: ${li * 0.35}s`} />
            </div>
          )}
          <div class="arch-layer flex flex-wrap justify-center gap-2">
            {layer.map((node) => (
              <span
                class={`arch-node rounded-lg border font-semibold text-center transition-all duration-300 ${
                  big ? "px-4 py-2.5 text-sm" : "px-3 py-1.5 text-xs"
                } ${li === 0 ? "border-white/25 bg-white/5 text-white/80" : "arch-node-accent"}`}
              >
                {node}
              </span>
            ))}
          </div>
        </>
      ))
    }
  </div>
</div>

<style>
  .arch-glow {
    background: radial-gradient(circle at 50% 0%, color-mix(in srgb, var(--accent) 35%, transparent), transparent 60%);
  }
  .arch-node-accent {
    border-color: color-mix(in srgb, var(--accent) 60%, transparent);
    background: color-mix(in srgb, var(--accent) 18%, transparent);
  }
  .arch-node:hover {
    transform: translateY(-2px);
    background: color-mix(in srgb, var(--accent) 40%, transparent);
    box-shadow: 0 0 24px color-mix(in srgb, var(--accent) 55%, transparent);
  }
  .arch-pulse {
    position: absolute;
    left: 50%;
    top: 0;
    width: 7px;
    height: 7px;
    margin-left: -3.5px;
    border-radius: 9999px;
    background: var(--accent);
    box-shadow: 0 0 12px var(--accent);
    animation: arch-travel 1.8s ease-in infinite;
  }
  @keyframes arch-travel {
    0% {
      top: 0;
      opacity: 0;
    }
    20% {
      opacity: 1;
    }
    100% {
      top: 100%;
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .arch-pulse {
      animation: none;
      display: none;
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { prefersReducedMotion } from "../scripts/reveal";
  gsap.registerPlugin(ScrollTrigger);

  if (!prefersReducedMotion()) {
    document.querySelectorAll<HTMLElement>("[data-arch-flow]").forEach((flow) => {
      if (flow.dataset.animated) return;
      flow.dataset.animated = "1";
      const tl = gsap.timeline({ scrollTrigger: { trigger: flow, start: "top 80%", toggleActions: "play none none none" } });
      flow.querySelectorAll(".arch-layer, .arch-link").forEach((el) => {
        if (el.classList.contains("arch-link")) {
          tl.fromTo(el, { scaleY: 0 }, { scaleY: 1, transformOrigin: "top", duration: 0.25, ease: "none" });
        } else {
          tl.fromTo(
            el.children,
            { opacity: 0, scale: 0.6, y: 10 },
            { opacity: 1, scale: 1, y: 0, clearProps: "opacity,transform", stagger: 0.06, duration: 0.35, ease: "back.out(2)" },
          );
        }
      });
    });
  }
</script>
